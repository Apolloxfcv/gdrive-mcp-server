# Aucun secret cote serveur n'est requis pour le mode stateless.
# Le token Google OAuth est transmis par le CLIENT MCP a chaque requete
# via le header "Authorization: Bearer <access_token>".
#
# Ces variables sont optionnelles, uniquement utiles si tu veux exposer
# une route utilitaire de generation de lien d'auth Google cote serveur.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
