# --- Application OAuth Google (obligatoire) ---
# Credentials OAuth 2.0 "Web application" de ton projet Google Cloud.
# Redirect URI a declarer chez Google : <PUBLIC_BASE_URL>/oauth/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- Secret de scellement (obligatoire) ---
# Chiffre/authentifie le state OAuth, les codes et les tokens remis aux
# clients MCP. 32 caracteres minimum. Generer avec :
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Le changer revoque tous les tokens emis (les clients devront se reconnecter).
OAUTH_TOKEN_SECRET=

# --- Liste blanche des redirect_uri des clients MCP (obligatoire) ---
# Separees par des virgules, comparaison exacte. Ex :
#   https://claude.ai/api/mcp/auth_callback,https://<callback-perplexity>
ALLOWED_REDIRECT_URIS=

# --- URL publique du serveur (recommande) ---
# Ex: https://gdrive-mcp-server.vercel.app (sans slash final).
# Par defaut : origine de la requete entrante.
PUBLIC_BASE_URL=

# --- Transition (optionnel) ---
# "true" = accepte encore les tokens Google bruts emis par l'ancienne version
# (verifies aupres de Google : audience = GOOGLE_OAUTH_CLIENT_ID). Les clients
# recoivent des tokens scelles des leur prochain refresh. A retirer ensuite.
ALLOW_LEGACY_GOOGLE_TOKENS=

# --- Limites (optionnel) ---
# Taille max d'un fichier telecharge depuis Drive, en octets (defaut 20 Mo).
MAX_DOWNLOAD_BYTES=
